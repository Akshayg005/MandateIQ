.coverage
htmlcov/
.env
*.db
node_modules/
dist/
.DS_Store
CLAUDE.local.md
# scaffold archives -- extracted on day 0, nothing references them
*.zip
reports/*.json
!reports/.gitkeep
# B11: cached model answers, namespaced by content-hashed prompt version
# (DECISIONS.md, 2026-08-30). Untracked deliberately -- eval/golden/*.jsonl
# right next to it is defined by NEVER being generated from model output,
# and a committed cache would blur that line. Costs one live run on a
# fresh clone.
eval/golden/.cache/
reports/*.log
reports/.bench_cache/
.env.bak*
.env.*.bak

# Written by `.\run.ps1 up`, read by `down`, to close the windows it opened.
.run-panes.json

# Third-party agent skills installed with `npx skills add` (taste-skill,
# ui-ux-pro-max). ~11MB of vendored prompts that are tooling, not this
# project's code. skills-lock.json is committed instead, so the set is
# reproducible without carrying the payload in a payments repo.
.agents/
.claude/skills/banner-design/
.claude/skills/brand/
.claude/skills/brandkit/
