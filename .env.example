# Razorpay -- TEST MODE ONLY. A key starting rzp_live_ will be blocked by
# scripts/guard_invariants.py and must never reach this repo.
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxx

# Gemini -- used only by src/llm/ and bench/. Never imported by src/model/,
# src/policy/, src/core/ or src/classify/ (invariant 1, guard_invariants.py).
GEMINI_API_KEY=AQ.xxxxxxxxxxxxxxxxxxxxxxxx
# Pinned ids, deliberately NOT the -latest aliases: a floating alias would
# silently move B12's run-to-run variance column, which is the whole argument.
# gemini-2.5-* is retired for new keys (404), verified 2026-08-30.
MODEL_NORMALIZER=gemini-3.5-flash-lite
MODEL_INTENT=gemini-3.5-flash-lite
MODEL_NARRATOR=gemini-3.5-flash

# If the mrdb container refuses to start with
#   "ports are not available ... bind: An attempt was made to access a
#    socket in a way forbidden by its access permissions"
# Windows has reserved a dynamic port range covering 5432. Check with
#   netsh int ipv4 show excludedportrange protocol=tcp
# Either free it (`net stop winnat; net start winnat`, as admin) or run
# the container on another host port and point this line at it -- the
# volume and container are otherwise unchanged. Seen 2026-08-31 with
# range 5341-5440; Windows reshuffles these ranges on reboot, so the
# block that bit you once will not be the block that bites you next.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/mandate_recovery

# Policy
COMPLIANCE_PROFILE=strict          # strict | permissive
CONFORMAL_COVERAGE=0.95
QUIET_HOURS_IST=21:00-09:00
MAX_CONTACTS_PER_CYCLE=2
